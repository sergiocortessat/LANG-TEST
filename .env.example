# Copy this file to .env and edit locally.
#   cp .env.example .env
# Never commit .env — it is gitignored.

# --- Stage 0: local LLM (Ollama) ---
# Ollama default API. No cloud key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Must match a name from `ollama list`. llama3.2 also matches llama3.2:latest.
OLLAMA_MODEL=llama3.2

# --- Stage 6: LangSmith tracing (leave off for now) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=invoice-assistant-lab
